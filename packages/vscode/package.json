{
  "name": "agent-theatre-vscode",
  "displayName": "Agent Theatre",
  "description": "Watch your coding agent work — as a film, not a log. Turns a Claude Code session into an animated scene inside VS Code.",
  "version": "1.7.0",
  "publisher": "agenttheatre",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1829",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shreyassaw5394/agent-theatre"
  },
  "homepage": "https://agenttheatre.dev",
  "bugs": {
    "url": "https://github.com/shreyassaw5394/agent-theatre/issues"
  },
  "keywords": [
    "claude code",
    "agent",
    "visualization",
    "replay",
    "ai"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentTheatre.open",
        "title": "Open the stage (live)",
        "category": "Agent Theatre",
        "icon": "$(play)"
      },
      {
        "command": "agentTheatre.replay",
        "title": "Replay a session…",
        "category": "Agent Theatre",
        "icon": "$(history)"
      },
      {
        "command": "agentTheatre.installHooks",
        "title": "Install Claude Code hooks",
        "category": "Agent Theatre"
      },
      {
        "command": "agentTheatre.uninstallHooks",
        "title": "Uninstall Claude Code hooks",
        "category": "Agent Theatre"
      },
      {
        "command": "agentTheatre.openInBrowser",
        "title": "Open the stage in the browser",
        "category": "Agent Theatre"
      },
      {
        "command": "agentTheatre.switchFolder",
        "title": "Switch folder (restart the stage)",
        "category": "Agent Theatre"
      },
      {
        "command": "agentTheatre.refreshChanges",
        "title": "Refresh",
        "category": "Agent Theatre",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTheatre.openChangesMap",
        "title": "Open the change map",
        "category": "Agent Theatre",
        "icon": "$(graph)"
      },
      {
        "command": "agentTheatre.copyChanges",
        "title": "Copy changes as Markdown",
        "category": "Agent Theatre",
        "icon": "$(copy)"
      },
      {
        "command": "agentTheatre.postChanges",
        "title": "Post changes to the pull request…",
        "category": "Agent Theatre",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "agentTheatre.toggleReads",
        "title": "Show or hide files only read",
        "category": "Agent Theatre",
        "icon": "$(eye)"
      },
      {
        "command": "agentTheatre.openChange",
        "title": "Open diff",
        "category": "Agent Theatre"
      }
    ],
    "configuration": {
      "title": "Agent Theatre",
      "properties": {
        "agentTheatre.set": {
          "type": "string",
          "default": "",
          "description": "Stage set id to open with (e.g. island, orbit, lanterns). Empty = let the picker suggest."
        },
        "agentTheatre.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the stage automatically when a workspace opens."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "agentTheatre.open"
        },
        {
          "command": "agentTheatre.replay"
        },
        {
          "command": "agentTheatre.openChange",
          "when": "false"
        },
        {
          "command": "agentTheatre.toggleReads",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentTheatre.openChangesMap",
          "when": "view == agentTheatre.changes",
          "group": "navigation@1"
        },
        {
          "command": "agentTheatre.postChanges",
          "when": "view == agentTheatre.changes",
          "group": "navigation@2"
        },
        {
          "command": "agentTheatre.copyChanges",
          "when": "view == agentTheatre.changes",
          "group": "navigation@3"
        },
        {
          "command": "agentTheatre.refreshChanges",
          "when": "view == agentTheatre.changes",
          "group": "navigation@4"
        },
        {
          "command": "agentTheatre.toggleReads",
          "when": "view == agentTheatre.changes",
          "group": "1_view"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "agentTheatre.changes",
          "name": "Agent changes",
          "icon": "media/icon.png",
          "contextualTitle": "Agent Theatre"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentTheatre.changes",
        "contents": "The files your coding agent reads, edits, creates and deletes show up here, from the newest Claude Code session in this folder.\n[Open the stage](command:agentTheatre.open)"
      }
    ],
    "colors": [
      {
        "id": "agentTheatre.created",
        "description": "Agent changes: a file the agent created",
        "defaults": {
          "dark": "#5ff0a6",
          "light": "#1a7f4b",
          "highContrast": "#5ff0a6"
        }
      },
      {
        "id": "agentTheatre.edited",
        "description": "Agent changes: a file the agent edited",
        "defaults": {
          "dark": "#ffb547",
          "light": "#9a5b00",
          "highContrast": "#ffb547"
        }
      },
      {
        "id": "agentTheatre.deleted",
        "description": "Agent changes: a file the agent deleted",
        "defaults": {
          "dark": "#ff7b69",
          "light": "#b42318",
          "highContrast": "#ff7b69"
        }
      },
      {
        "id": "agentTheatre.outside",
        "description": "Agent changes: changed during the session, not by the agent",
        "defaults": {
          "dark": "#7cc8ff",
          "light": "#1f5f99",
          "highContrast": "#7cc8ff"
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @agent-theatre/web exec vite build --base=./ --outDir dist-vscode && tsup && node scripts/copy-web.mjs && node ../../scripts/third-party-licenses.mjs THIRD_PARTY_LICENSES.txt ../web/dist-vscode dist",
    "package": "pnpm build && vsce package --no-dependencies --out agent-theatre.vsix",
    "test:vscode": "node tests-electron/run.mjs"
  },
  "dependencies": {
    "@agent-theatre/core": "workspace:*",
    "agent-theatre": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
